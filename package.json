{
  "name": "ucode-agent",
  "version": "1.68.1",
  "description": "Free, open-source AI coding agent for your terminal: builds whole apps in about a minute on Google Gemini's free tier, edits real code, checks and fixes its own work.",
  "type": "module",
  "main": "ucode.js",
  "bin": {
    "ucode": "ucode.js"
  },
  "files": [
    "ucode.js",
    "src/",
    "skills/",
    "templates/",
    "THIRD_PARTY_NOTICES.md",
    "NOTICE",
    "LICENSE-DOCS"
  ],
  "scripts": {
    "start": "node ucode.js",
    "test": "node test/run.js",
    "prepublishOnly": "node scripts/no-bundled-key.js && node test/run.js",
    "hooks": "node scripts/install-hooks.js",
    "eval": "node test/evals/run.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sppideey/ucode-agent.git"
  },
  "bugs": {
    "url": "https://github.com/sppideey/ucode-agent/issues"
  },
  "homepage": "https://github.com/sppideey/ucode-agent#readme",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "coding-agent",
    "ai-coding-assistant",
    "ai-coding-agent",
    "agentic-coding",
    "cli",
    "terminal",
    "tui",
    "llm",
    "gemini",
    "google-gemini",
    "gemini-api",
    "ollama",
    "mcp",
    "model-context-protocol",
    "code-generation",
    "developer-tools",
    "claude-code-alternative",
    "codex-alternative",
    "free"
  ],
  "author": "om dixit",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "chalk": "^6.0.0",
    "dotenv": "^18.0.3",
    "jsonrepair": "^3.15.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^7.23.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
