# ucode talks to NVIDIA and Cohere models through OpenRouter.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here

# Optional: web search (free tier at https://tavily.com)
# TAVILY_API_KEY=your-key-here

# Optional overrides
# UCODE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# UCODE_MAX_CONTEXT_TOKENS=200000
# UCODE_MAX_STEPS=250
